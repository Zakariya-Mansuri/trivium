# --- App ---
ENVIRONMENT=development            # development | test | production
DEBUG=false

# --- Database ---
# Local default is SQLite; on Render this is injected from the managed Postgres.
DATABASE_URL=sqlite:///./trivium.db
# DATABASE_URL=postgresql://user:pass@host:5432/trivium

# --- Security (REQUIRED in production: set a long random value) ---
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: comma-separated frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM provider (mock works fully offline; no key needed) ---
LLM_PROVIDER=mock                  # mock | openai | groq | anthropic | sarvam
LLM_API_KEY=
LLM_MODEL=                         # blank = per-provider default

# --- Learning science knobs ---
DIFFUSE_MODE_DELAY_HOURS=12
MIN_REVIEW_GAP_HOURS=4
REVIEW_SESSION_SIZE=10

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_LLM=30/minute
